# Copy to .env.local for local development. Never commit real values.
# In production these live in Netlify: Project configuration > Environment variables.
# Each stage adds only the keys it needs.

# Public site address.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (London). Both values are public by design; row-level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
